import pygame
import math
import time
from datetime import datetime

# -------------------------------
# 1. 기본 초기화
# -------------------------------
pygame.init()

WIDTH, HEIGHT = 1200, 400
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Water Clock")
clock = pygame.time.Clock()

# -------------------------------
# 2. 색상 정의
# -------------------------------
COLORS = [
    {"start": (59, 130, 246, 230), "end": (37, 99, 235, 230)},  # Hours
    {"start": (6, 182, 212, 230), "end": (14, 165, 233, 230)},  # Minutes
    {"start": (20, 184, 166, 230), "end": (16, 185, 129, 230)}, # Seconds
]

BACKGROUND = (15, 23, 42)
CONTAINER_BG = (30, 41, 59)

# -------------------------------
# 3. 시계 설정
# -------------------------------
CONTAINERS = [
    {"max": 24, "get_value": lambda: datetime.now().hour},
    {"max": 60, "get_value": lambda: datetime.now().minute},
    {"max": 60, "get_value": lambda: datetime.now().second},
]

# -------------------------------
# 4. 물결 그리기 함수
# -------------------------------
def draw_wave(surface, rect, color_start, color_end, offset):
    wave_layers = [
        {"amplitude": 12, "frequency": 0.02, "speed": 0.03, "opacity": 255},
        {"amplitude": 8, "frequency": 0.03, "speed": 0.05, "opacity": 180},
        {"amplitude": 6, "frequency": 0.04, "speed": 0.04, "opacity": 130},
    ]

    width, height = rect[2], rect[3]
    top_margin = 10

    for idx, wave in enumerate(wave_layers):
        points = []
        for x in range(width + 1):
            y = top_margin + math.sin(x * wave["frequency"] + offset * wave["speed"] + idx) * wave["amplitude"]
            points.append((rect[0] + x, rect[1] + y))
        # 닫기
        points.append((rect[0] + width, rect[1] + height))
        points.append((rect[0], rect[1] + height))

        # 그라디언트 채우기
        wave_surface = pygame.Surface((width, height), pygame.SRCALPHA)
        pygame.draw.polygon(wave_surface, (*color_start[:3], wave["opacity"]), [(x - rect[0], y - rect[1]) for x, y in points])
        surface.blit(wave_surface, (rect[0], rect[1]))

# -------------------------------
# 5. 메인 루프
# -------------------------------
offset = 0
running = True
while running:
    screen.fill(BACKGROUND)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # 컨테이너 위치 계산
    margin = 50
    box_width = (WIDTH - margin * 4) // 3
    box_height = HEIGHT - margin * 2

    for i, container in enumerate(CONTAINERS):
        x = margin + i * (box_width + margin)
        y = margin
        rect = (x, y, box_width, box_height)

        # 컨테이너 배경
        pygame.draw.rect(screen, CONTAINER_BG, rect, border_radius=20)

        # 현재 값 및 높이 계산
        value = container["get_value"]()
        water_level = (value / container["max"]) * box_height
        water_rect = (x, y + box_height - water_level, box_width, water_level)

        # 물 그리기
        draw_wave(screen, water_rect, COLORS[i]["start"], COLORS[i]["end"], offset)

    offset += 1
    pygame.display.flip()
    clock.tick(60)

pygame.quit()
